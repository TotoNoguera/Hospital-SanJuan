// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  ADMIN
  SECRETARY
  DOCTOR
}

// ONLINE: el paciente reserva un horario real (tiene profesionales + disponibilidad).
// ASSISTED: refleja cómo se saca el turno hoy en el hospital (orden médica, presencial,
// WhatsApp, email) — la web solo automatiza el contacto, no inventa un calendario.
enum BookingMode {
  ONLINE
  ASSISTED
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Patient {
  id           String        @id @default(cuid())
  name         String
  dni          String
  email        String        @unique
  phone        String
  passwordHash String
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

model StaffUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         StaffRole
  doctorId     String?   @unique
  doctor       Doctor?   @relation(fields: [doctorId], references: [id])
  createdAt    DateTime  @default(now())
}

model Specialty {
  id                   String        @id @default(cuid())
  name                 String
  slug                 String        @unique
  icon                 String        @default("stethoscope")
  order                Int           @default(0)
  bookingMode          BookingMode   @default(ASSISTED)
  // Copia fiel de la planilla real del hospital para las especialidades ASSISTED.
  howToBook            String?
  days                 String?
  hours                String?
  requiresMedicalOrder Boolean       @default(false)
  contactPhone         String?
  contactExtension     String?
  contactEmail         String?
  contactWhatsapp      String?
  doctors              Doctor[]
  appointments         Appointment[]
}

model Doctor {
  id           String         @id @default(cuid())
  name         String
  bio          String?
  photoUrl     String?
  active       Boolean        @default(true)
  specialtyId  String
  specialty    Specialty      @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  availability Availability[]
  appointments Appointment[]
  staffUser    StaffUser?
}

model Availability {
  id          String @id @default(cuid())
  doctorId    String
  doctor      Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  // 0 = domingo … 6 = sábado (Date#getDay)
  weekday     Int
  startTime   String
  endTime     String
  slotMinutes Int    @default(20)
}

model Appointment {
  id          String            @id @default(cuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialtyId String
  specialty   Specialty         @relation(fields: [specialtyId], references: [id])
  date        DateTime
  status      AppointmentStatus @default(CONFIRMED)
  notes       String?
  createdAt   DateTime          @default(now())
}
