# Base de datos PostgreSQL (Neon, Railway, Vercel Postgres, etc.)
# Formato: postgresql://usuario:contraseña@host:puerto/base_de_datos
DATABASE_URL="postgresql://usuario:contraseña@host:puerto/hospital_san_juan"

# JWT Secret para firmar sesiones (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# IMPORTANTE: Genera uno nuevo para producción, diferente al de desarrollo
SESSION_SECRET="generar-una-cadena-aleatoria-larga-min-32-caracteres"

# Info pública del hospital
NEXT_PUBLIC_HOSPITAL_NAME="Hospital San Juan"

# Central de Turnos WhatsApp (formato internacional, sin +, sin espacios)
# Ej: 5492211234567
NEXT_PUBLIC_WHATSAPP_NUMBER="5492210000000"

# ========== CONFIGURACIÓN DE EMAIL (OPCIONAL) ==========
# Si se deja vacío, el sistema omite el envío de mail y solo ofrece WhatsApp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Hospital San Juan <turnos@hospitalsanjuan.example>"
